{
  "manifest_version": 3,
  "name": "TrackAI Course Capture",
  "version": "0.1.0",
  "description": "Capture course syllabi to your TrackAI dashboard",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://learnflow-backend-o17z.onrender.com"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://learn-flow-beige.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Capture course to TrackAI"
  }
}